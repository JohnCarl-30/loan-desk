{
  "name": "loandesk",
  "version": "0.1.0",
  "private": true,
  "description": "Mortgage lead qualifying desk. Money is cents. Mapping failures are 4xx.",
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "nest start --watch",
    "dev:web": "vite",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "build": "nest build && vite build",
    "start": "NODE_ENV=production node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.web.json --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.3",
    "@nestjs/core": "^11.2.3",
    "@nestjs/platform-express": "^11.2.3",
    "better-sqlite3": "^12.2.0",
    "dotenv": "^16.6.1",
    "libphonenumber-js": "^1.12.10",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^11.0.7",
    "@nestjs/testing": "^11.2.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.3",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.1",
    "jest": "^29.7.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.1",
    "typescript": "^5.9.2",
    "vite": "^6.3.5"
  }
}
