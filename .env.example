# Copy to .env. Never commit .env.
# LoanDesk boots without secrets. Tests and the simulated call work with empty values.

PORT=8787
DATABASE_PATH=./data/loandesk.sqlite
CRM_OUTBOX_PATH=./data/crm-outbox.jsonl

# Outbound CRM webhook. If unset, CRM posts land in SQLite + the outbox file.
CRM_WEBHOOK_URL=

# Optional. Simulated call and tests use fixture replies when this is missing.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional. Simulated call works without this. Voice posts still hit POST /webhooks/voice.
VAPI_API_KEY=

# Leave empty in development. Vite proxies to the API.
CORS_ORIGIN=

# Stamped on every lead. Bump when the qualifier copy changes.
PROMPT_VERSION=loandesk-qualifier-v1
